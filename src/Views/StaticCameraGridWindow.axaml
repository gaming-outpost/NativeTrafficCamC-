<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CoastalCommandCenter.Views.StaticCameraGridWindow"
        Title="Static Camera Grid"
        Width="560" Height="450"
        MinWidth="560" MinHeight="450"
        CanResize="True"
        SystemDecorations="None"
        Background="{DynamicResource BrushPopoutWindowBackground}"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

  <Border BorderBrush="{DynamicResource BrushPopoutBorder}" BorderThickness="1">
    <Grid RowDefinitions="30,32,*">
    <Border Grid.Row="0"
            Background="{DynamicResource BrushPopoutTitleBarBackground}"
            Cursor="SizeAll"
            PointerPressed="TitleBar_OnPointerPressed"
            PointerMoved="TitleBar_OnPointerMoved"
            PointerReleased="TitleBar_OnPointerReleased">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   x:Name="GridTitleText"
                   VerticalAlignment="Center"
                   Margin="8,0"
                   FontSize="12"
                   FontFamily="Rajdhani, Tahoma, sans-serif"
                   FontWeight="SemiBold"
                   LetterSpacing="0.5"
                   Foreground="{DynamicResource BrushPopoutTitleForeground}"
                   Text="STATIC VIEWS" />
        <Button Grid.Column="1"
                x:Name="FullscreenButton"
                Content="⛶"
                FontSize="13"
                Width="30" Height="30"
                Background="Transparent"
                Foreground="{DynamicResource BrushPopoutTitleForeground}"
                BorderThickness="0"
                VerticalAlignment="Center"
                ToolTip.Tip="Toggle fullscreen (F11)"
                Click="FullscreenButton_OnClick" />
        <Button Grid.Column="2"
                Content="✕"
                FontSize="12"
                Width="30" Height="30"
                Background="Transparent"
                Foreground="{DynamicResource BrushPopoutCloseForeground}"
                BorderThickness="0"
                VerticalAlignment="Center"
                ToolTip.Tip="Close static views"
                Click="CloseButton_OnClick" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource BrushPopoutTileHeaderBackground}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto"
            Margin="8,0">
        <Button Grid.Column="0"
                x:Name="RefreshButton"
                Content="REFRESH ALL"
                FontSize="10"
                Height="22"
                MinWidth="92"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Click="RefreshButton_OnClick" />
        <CheckBox Grid.Column="1"
                  x:Name="AutoRefreshToggle"
                  Content="Auto refresh"
                  Foreground="{DynamicResource BrushTextWhite}"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  IsChecked="True"
                  Checked="AutoRefreshToggle_OnChanged"
                  Unchecked="AutoRefreshToggle_OnChanged" />
        <TextBlock Grid.Column="2"
                   x:Name="RefreshStatusText"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource BrushTextSubtle}"
                   FontSize="10"
                   Text="Ready." />
        <TextBlock Grid.Column="3"
                   x:Name="RefreshIntervalText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource BrushPopoutTitleForeground}"
                   FontSize="10"
                   FontWeight="Bold"
                   Text="AUTO 180s" />
      </Grid>
    </Border>

    <Canvas Grid.Row="2"
            x:Name="CameraCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource BrushPopoutWindowBackground}"
            RenderOptions.BitmapInterpolationMode="LowQuality" />

    <Border x:Name="ResizeGrip"
            Grid.RowSpan="3"
            Width="18"
            Height="18"
            Margin="0,0,6,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visual.ZIndex="10"
            Background="{DynamicResource BrushPopoutTileHeaderBackground}"
            CornerRadius="2"
            Opacity="0.65"
            PointerPressed="ResizeGrip_OnPointerPressed">
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="11"
                 FontWeight="Bold"
                 Foreground="{DynamicResource BrushPopoutTitleForeground}"
                 Text="◢" />
    </Border>
    </Grid>
  </Border>
</Window>
